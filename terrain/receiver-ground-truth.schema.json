{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receiver ground truth",
  "description": "Elapsed seconds from scenario start; WGS84 longitude/latitude; height above the WGS84 ellipsoid. Samples start at zero, follow sample_period_s and exclude the terminal validation state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "sample_period_s", "ground_truth"],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sample_period_s": { "type": "number", "exclusiveMinimum": 0 },
    "ground_truth": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp_s", "object_id", "lat", "lon", "hae_m"],
        "properties": {
          "timestamp_s": { "type": "number", "minimum": 0 },
          "object_id": { "type": "string", "minLength": 1 },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "hae_m": { "type": "number" }
        }
      }
    }
  }
}
